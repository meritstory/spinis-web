{% set history = complaint.statusHistory %}
{% if history is empty %}
    <p class="ea-complaint-empty">{{ 'complaint.history.empty'|trans }}</p>
{% else %}
    <div class="ea-complaint-edit-stack ea-complaint-edit-stack--compact">
        {% for entry in history %}
            {{ include('admin/field/_complaint_edit_field.html.twig', {
                label: ('complaint.status.' ~ entry.status)|trans,
                value: entry.changedAt|date('Y-m-d'),
            }) }}
        {% endfor %}
    </div>
{% endif %}
