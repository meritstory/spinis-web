<a class="logo" title="{{ 'app.name'|trans }}" href="{{ path(ea.dashboardRouteName) }}">
    <span class="logo-custom ea-dashboard-logo">
        <span class="ea-dashboard-logo__accent">{{ 'app.admin_logo.accent'|trans }}</span>
        <span class="ea-dashboard-logo__line">{{ 'app.admin_logo.line2'|trans }}</span>
        <span class="ea-dashboard-logo__line">{{ 'app.admin_logo.line3'|trans }}</span>
    </span>
    <span class="logo-compact"><twig:ea:Icon name="internal:home" /></span>
</a>
