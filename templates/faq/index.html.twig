{% extends 'base.html.twig' %}

{% block title %}{{ 'faq_page.title'|trans }}{% endblock %}

{% block body %}
    <main>
        <section class="pt-8 pb-16 bg-page">
            <div class="mx-auto max-w-[1200px] px-6">
                {% include '_breadcrumb.html.twig' with {crumbs: [{label: 'faq_page.breadcrumb.current'|trans}]} %}

                <h1 class="mt-8 mb-5 text-heading-h1 font-bold">{{ 'faq_page.heading'|trans }}</h1>
                <p class="max-w-[720px] text-body-lg text-text-secondary">{{ 'faq_page.description'|trans }}</p>
            </div>
        </section>

        <section class="py-20 bg-white">
            <div class="mx-auto max-w-[1200px] px-6">
                {% include '_faq_accordion.html.twig' with {faqs: faqs, openFirst: true} %}
            </div>
        </section>

        {% include '_cta_section.html.twig' with {
            heading: 'faq_page.still_questions.heading'|trans,
            description: 'faq_page.still_questions.description'|trans,
            cta: 'faq_page.still_questions.cta'|trans,
            href: path('contacts'),
        } %}
    </main>
{% endblock %}
